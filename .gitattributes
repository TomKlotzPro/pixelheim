# The release flows, a line each (PIX-273): two branches adding flows at the
# same place keep both on a merge or a rebase instead of conflicting. A flow
# both sides changed comes out twice, and tools/flows.py refuses a name
# given twice, so nothing passes unseen.
godot/tools/flows.txt merge=union
# The areas of the files that aren't scripts (PIX-353), a line each, merged
# the same way: tools/test_areas.py refuses a glob named twice.
godot/tools/areas.txt merge=union
# The harness's flags and report fields and the look book's shots
# (PIX-356), a line each, merged the same way: test_registries refuses a
# name given twice.
godot/scripts/harness_flags.txt merge=union
godot/scripts/harness_report.txt merge=union
godot/scripts/lookbook_shots.jsonl merge=union
# A feature's own flows and rows (PIX-361), merged the same way.
godot/tools/flows.d/*.txt merge=union
godot/scripts/features/*/*.txt merge=union
godot/scripts/features/*/*.jsonl merge=union

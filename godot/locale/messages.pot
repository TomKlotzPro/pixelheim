#: assets/data/changelog.json
msgid "The Ember Seal"
msgstr ""

#: assets/data/changelog.json
msgid "The First Night"
msgstr ""

#: assets/data/changelog.json
msgid "The Forge: pay Hilda to sharpen any weapon or armor, up to +7"

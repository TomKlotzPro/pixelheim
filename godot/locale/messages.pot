#: assets/data/changelog.json
msgid "The Fork in the Path"
msgstr ""

#: assets/data/changelog.json
msgid "The Frostgate"
msgstr ""

#: assets/data/changelog.json
msgid "The Great Expansion"
msgstr ""

#: assets/data/changelog.json
msgid "The HUD's Map button speaks a proper event now instead of faking an M keypress - it keeps working even after you rebind your keys"

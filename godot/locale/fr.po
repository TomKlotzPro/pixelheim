# Pixelheim in fr (PIX-195). Translate the msgstr lines; tools/i18n.py merges new strings in.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: fr\nPlural-Forms: nplurals=2; plural=(n > 1);\n"

#: assets/data/catalog.json
msgid "A ball of ice that never melts, held in the off hand. Blows come slower near it. Crafted, never sold."
msgstr "Une boule de glace qui ne fond jamais, tenue dans la main gauche. Près d'elle, les coups ralentissent. Fait main, jamais en vente."

#: assets/data/catalog.json
msgid "A black-rinded cheese aged deep in the Blackiron shafts. It hums, faintly. Bram will be beside himself."
msgstr "Un fromage à croûte noire, affiné au fond des puits de Fernoir. Il bourdonne, à peine. Bram va être dans tous ses états."

#: assets/data/catalog.json
msgid "A blade of sea-glass edge on a pearl grip. It hums like a shell held to the ear. Crafted, never sold."
msgstr "Une lame au fil de verre de mer sur une poignée de nacre. Elle murmure comme un coquillage qu'on porte à l'oreille. Fait main, jamais en vente."

#: assets/data/catalog.json
msgid "A blast of cold that can freeze the enemy solid."
msgstr "Un souffle glacial qui peut geler l'ennemi sur place."

#: assets/data/catalog.json
msgid "A blessed blow of righteous strength."
msgstr "Un coup béni, d'une force vertueuse."

#: assets/data/catalog.json
msgid "A brass storm-lantern, its glass etched with stars. Liane lit it the night before the climb so the five could find their way home. One of the relics the five left behind."
msgstr "Une lampe-tempête en laiton, au verre gravé d'étoiles. Liane l'a allumée la veille de l'ascension, pour que les cinq retrouvent le chemin du retour. L'une des reliques que les cinq ont laissées derrière eux."

#: assets/data/catalog.json
msgid "A bronze-rimmed shield, dented and polished. Oskar left it at Greyhold when he climbed the mountain: \"Keep it till I'm home.\" One of the relics the five left behind."
msgstr "Un bouclier cerclé de bronze, cabossé et poli. Oskar l'a laissé à Greyhold quand il a gravi la montagne : « Garde-le jusqu'à mon retour. » L'une des reliques que les cinq ont laissées derrière eux."

#: assets/data/catalog.json
msgid "A coated dagger that leaves the enemy poisoned."
msgstr "Une dague enduite qui laisse l'ennemi empoisonné."

#: assets/data/catalog.json
msgid "A cook's ladle, black iron, the handle wrapped in sailcloth. Tam carried it up the mountain fifty years ago. One of the relics the five left behind."
msgstr "Une louche de cuisinier en fer noir, le manche entouré de toile à voile. Tam l'a emportée sur la montagne il y a cinquante ans. L'une des reliques que les cinq ont laissées derrière eux."

#: assets/data/catalog.json
msgid "A creeping rot that poisons for several turns."
msgstr "Une pourriture rampante qui empoisonne pendant plusieurs tours."

#: assets/data/catalog.json
msgid "A cruel arrowhead that leaves the wound poisoned."
msgstr "Une pointe cruelle qui laisse la plaie empoisonnée."

#: assets/data/catalog.json
msgid "A crushing blow dealing heavy physical damage."
msgstr "Un coup écrasant qui inflige de lourds dégâts physiques."

#: assets/data/catalog.json
msgid "A dependable blade of honest iron."
msgstr "Une lame fiable, forgée dans un fer honnête."

#: assets/data/catalog.json
msgid "A door of black iron with a handle. Goblins have broken teeth on it. Crafted, never sold."
msgstr "Une porte de fer noir, avec une poignée. Des gobelins s'y sont cassé les dents. Fait main, jamais en vente."

#: assets/data/catalog.json
msgid "A dragon's scale honed to a whisper. Crafted, never sold."
msgstr "Une écaille de dragon affûtée jusqu'à n'être plus qu'un murmure. Fait main, jamais en vente."

#: assets/data/catalog.json
msgid "A drop of glass with a thought caught inside."
msgstr "Une goutte de verre où une pensée est restée prise."

#: assets/data/catalog.json
msgid "A fat white pearl from the Saltmere shallows. Odo will want it; so will Mirelle."
msgstr "Une grosse perle blanche des hauts-fonds de Saltmere. Odo la voudra ; Mirelle aussi."

#: assets/data/catalog.json
msgid "A fisher's long coat, oiled until the sea gives up on it. Crafted, never sold."
msgstr "Un long manteau de pêcheur, huilé jusqu'à ce que la mer abandonne la partie. Fait main, jamais en vente."

#: assets/data/catalog.json
msgid "A knight's seal ring, a hundred years under the bog. It still remembers its oath. Hunted, never sold."
msgstr "La bague à sceau d'un chevalier, restée cent ans sous la tourbe. Elle se souvient encore de son serment. Trophée de chasse, jamais en vente."

#: assets/data/catalog.json
msgid "A knuckle of something big, on a cord. It remembers being strong."
msgstr "Une phalange de quelque chose d'énorme, au bout d'un cordon. Elle se souvient d'avoir été forte."

#: assets/data/catalog.json
msgid "A lash of stolen life for heavy magic damage."
msgstr "Un fouet de vie volée qui inflige de lourds dégâts magiques."

#: assets/data/catalog.json
msgid "A mantle of moss and scale that death declines to touch. Crafted, never sold."
msgstr "Un manteau de mousse et d'écailles que la mort se garde bien de toucher. Fait main, jamais en vente."

#: assets/data/catalog.json
msgid "A measured arrow to a weak point for heavy dexterity damage."
msgstr "Une flèche ajustée sur un point faible, pour de lourds dégâts de dextérité."

#: assets/data/catalog.json
msgid "A pale flower that only opens in the snow. Vex says it keeps a spell cold."
msgstr "Une fleur pâle qui ne s'ouvre que dans la neige. Vex dit qu'elle garde un sort bien froid."

#: assets/data/catalog.json
msgid "A pebble of the mountain's anger. Warm forever. Found in the ash fields."
msgstr "Un caillou de la colère de la montagne. Chaud pour toujours. Se trouve dans les Champs de Cendres."

#: assets/data/catalog.json
msgid "A round shield in the town's blue, its rim beaten from the old gate's hinges."
msgstr "Un bouclier rond peint du bleu de la ville, le bord martelé dans les gonds de l'ancienne porte."

#: assets/data/catalog.json
msgid "A shard of a fallen star set in blackwood. The mountain's deep floors keep a few."
msgstr "Un éclat d'étoile tombée, serti dans du bois noir. Les étages profonds de la montagne en gardent quelques-uns."

#: assets/data/catalog.json
msgid "A short blade gone dull with use. Quick in quick hands."
msgstr "Une lame courte émoussée par l'usage. Vive dans des mains vives."

#: assets/data/catalog.json
msgid "A small brass locket with a red stone. Inside, a girl's face, worn soft by a thumb."
msgstr "Un petit médaillon de laiton orné d'une pierre rouge. À l'intérieur, le visage d'une fille, estompé à force d'être effleuré du pouce."

#: assets/data/catalog.json
msgid "A small cask stamped with a skull that someone has tried to scrape off. It sloshes ominously."
msgstr "Un petit tonnelet marqué d'une tête de mort que quelqu'un a tenté de gratter. Il clapote de manière inquiétante."

#: assets/data/catalog.json
msgid "A soldier's badge from Greyhold, the tower on it worn smooth by a thumb."
msgstr "Un insigne de soldat de Greyhold, dont la tour a été polie par un pouce."

#: assets/data/catalog.json
msgid "A staggering bash that can stun the enemy for a turn."
msgstr "Un choc à faire chanceler, qui peut étourdir l'ennemi pendant un tour."

#: assets/data/catalog.json
msgid "A tarnished brooch with five marks, the last one hers. She wore it fifty years. It's a promise that someone would finish what the five started. The fifth relic."
msgstr "Une broche ternie à cinq marques, la dernière est la sienne. Elle l'a portée cinquante ans. C'est la promesse que quelqu'un finirait ce que les cinq avaient commencé. La cinquième relique."

#: assets/data/catalog.json
msgid "A very small, very cross yellow bird. It wants to go home."
msgstr "Un tout petit oiseau jaune, très fâché. Il veut rentrer chez lui."

#: assets/data/catalog.json
msgid "A ward of light that heals and purges all ailments."
msgstr "Une égide de lumière qui soigne et dissipe tous les maux."

#: assets/data/catalog.json
msgid "A white staff tipped with frost lily ice. It hums when it's cold, which is always. Crafted, never sold."
msgstr "Un bâton blanc coiffé de glace de lys de givre. Il bourdonne quand il fait froid, c'est-à-dire toujours. Fait main, jamais en vente."

#: assets/data/catalog.json
msgid "Aegis of the Ash"
msgstr "Égide des Cendres"

#: assets/data/catalog.json
msgid "Aimed Shot"
msgstr "Tir ajusté"

#: assets/data/catalog.json
msgid "An ingot from the seam the Ember Seal was cast from, stamped with five marks. The five took a cartload; this one waited. One of the relics the five left behind."
msgstr "Un lingot du filon dont fut coulé le Sceau de braise, frappé de cinq marques. Les cinq en ont emporté une charrette ; celui-ci a attendu. L'une des reliques que les cinq ont laissées derrière eux."

#: assets/data/catalog.json
msgid "An iron-bound box with a caravan's mark. Something has chewed one corner."
msgstr "Un coffre cerclé de fer, à la marque d'une caravane. Quelque chose en a rongé un coin."

#: assets/data/catalog.json
msgid "Antidote"
msgstr "Antidote"

#: assets/data/catalog.json
msgid "Apple"
msgstr "Pomme"

#: assets/data/catalog.json
msgid "Apprentice Staff"
msgstr "Bâton d'apprenti"

#: assets/data/catalog.json
msgid "Archmage Staff"
msgstr "Bâton d'archimage"

#: assets/data/catalog.json
msgid "Armor outside, faith inside"
msgstr "Armure dehors, foi dedans"

#: assets/data/catalog.json
msgid "Armored faith. Takes the hits, returns them blessed, mends the rest."
msgstr "La foi en armure. Encaisse les coups, les rend bénis, soigne le reste."

#: assets/data/catalog.json
msgid "Ash-field shards bound in living wood. Crafted, never sold."
msgstr "Des éclats des Champs de Cendres, enchâssés dans du bois vivant. Fait main, jamais en vente."

#: assets/data/catalog.json
msgid "Backstab"
msgstr "Coup dans le dos"

#: assets/data/catalog.json
msgid "Band of Grit"
msgstr "Anneau de cran"

#: assets/data/catalog.json
msgid "Banquet Ribs"
msgstr "Côtes de banquet"

#: assets/data/catalog.json
msgid "Barbed Arrow"
msgstr "Flèche barbelée"

#: assets/data/catalog.json
msgid "Beast Cleaver"
msgstr "Couperet des bêtes"

#: assets/data/catalog.json
msgid "Berserk"
msgstr "Furie"

#: assets/data/catalog.json
msgid "Bitter leaves the healers swear by. Foraged in the forest."
msgstr "Des feuilles amères : les guérisseurs ne jurent que par elles. Cueillies en forêt."

#: assets/data/catalog.json
msgid "Bitter marsh brew that puts the wind back in you."
msgstr "Une infusion amère des marais qui vous redonne du souffle."

#: assets/data/catalog.json
msgid "Blackiron Axe"
msgstr "Hache de Fernoir"

#: assets/data/catalog.json
msgid "Blackiron Bulwark"
msgstr "Rempart de Fernoir"

#: assets/data/catalog.json
msgid "Blackiron Gauntlets"
msgstr "Gantelets de Fernoir"

#: assets/data/catalog.json
msgid "Blackiron Helm"
msgstr "Heaume de Fernoir"

#: assets/data/catalog.json
msgid "Blackiron Ore"
msgstr "Minerai de Fernoir"

#: assets/data/catalog.json
msgid "Blackiron Plate"
msgstr "Plates de Fernoir"

#: assets/data/catalog.json
msgid "Blackiron Sabatons"
msgstr "Solerets de Fernoir"

#: assets/data/catalog.json
msgid "Blight"
msgstr "Flétrissure"

#: assets/data/catalog.json
msgid "Boiled leather. Keeps the rain and the smaller teeth out."
msgstr "Cuir bouilli. Protège de la pluie et des plus petites dents."

#: assets/data/catalog.json
msgid "Bone Charm"
msgstr "Talisman d'os"

#: assets/data/catalog.json
msgid "Bookshelf"
msgstr "Bibliothèque"

#: assets/data/catalog.json
msgid "Border-guard issue. The soles outlast the guards."
msgstr "Dotation des gardes-frontières. Les semelles survivent aux gardes."

#: assets/data/catalog.json
msgid "Bread Loaf"
msgstr "Miche de pain"

#: assets/data/catalog.json
msgid "Brewed round a dragon's scale. One swallow and every wound and every spent breath comes back."
msgstr "Infusé autour d'une écaille de dragon. Une gorgée, et chaque blessure se referme, chaque souffle perdu revient."

#: assets/data/catalog.json
msgid "Broken blades and rusted mail from Greyhold's armoury. Good steel under the rust."
msgstr "Lames brisées et mailles rouillées de l'armurerie de Greyhold. Du bon acier sous la rouille."

#: assets/data/catalog.json
msgid "Candelabra"
msgstr "Candélabre"

#: assets/data/catalog.json
msgid "Channels light to restore health."
msgstr "Canalise la lumière pour rendre de la santé."

#: assets/data/catalog.json
msgid "Cheese Wheel"
msgstr "Meule de fromage"

#: assets/data/catalog.json
msgid "Chops wood. Chops other things too."
msgstr "Coupe du bois. Coupe d'autres choses aussi."

#: assets/data/catalog.json
msgid "Cinderjaw's scales hammered over oak. It is still warm on the inside. Hunted, never sold."
msgstr "Les écailles de Mâchebraise, martelées sur du chêne. Il est encore chaud à l'intérieur. Trophée de chasse, jamais en vente."

#: assets/data/catalog.json
msgid "Cinderscale Shield"
msgstr "Bouclier Écaillebraise"

#: assets/data/catalog.json
msgid "City Plate"
msgstr "Armure de la Cité"

#: assets/data/catalog.json
msgid "Cleric"
msgstr "Clerc"

#: assets/data/catalog.json
msgid "Cold silver that hums faintly at night. The mind runs clearer."
msgstr "Un argent froid qui bourdonne doucement la nuit. L'esprit s'en trouve plus clair."

#: assets/data/catalog.json
msgid "Consecrate"
msgstr "Consécration"

#: assets/data/catalog.json
msgid "Crimson wool from the western looms. Ties the room together. Placed at home: +5% gold from every fight."
msgstr "Laine cramoisie des métiers à tisser de l'ouest. Il harmonise toute la pièce. Chez vous : +5 % d'or à chaque combat."

#: assets/data/catalog.json
msgid "Crown of the Deathless"
msgstr "Couronne des Sans-Mort"

#: assets/data/catalog.json
msgid "Crystal of the Fifteenth Depth"
msgstr "Cristal de la quinzième profondeur"

#: assets/data/catalog.json
msgid "Crystal of the Fifth Depth"
msgstr "Cristal de la cinquième profondeur"

#: assets/data/catalog.json
msgid "Crystal of the Fiftieth Depth"
msgstr "Cristal de la cinquantième profondeur"

#: assets/data/catalog.json
msgid "Crystal of the Tenth Depth"
msgstr "Cristal de la dixième profondeur"

#: assets/data/catalog.json
msgid "Crystal of the Thirtieth Depth"
msgstr "Cristal de la trentième profondeur"

#: assets/data/catalog.json
msgid "Crystal of the Twentieth Depth"
msgstr "Cristal de la vingtième profondeur"

#: assets/data/catalog.json
msgid "Cures burning and restores 5 HP. Apply liberally, scream less."
msgstr "Guérit la brûlure et rend 5 PV. Appliquer généreusement, crier moins."

#: assets/data/catalog.json
msgid "Cures poison and restores 5 HP. Tastes like swamp, works like magic."
msgstr "Guérit le poison et rend 5 PV. Goût de marécage, effet magique."

#: assets/data/catalog.json
msgid "Cut from the warden's lair. It hums when you hold it near the stair."
msgstr "Taillé dans l'antre du gardien. Il bourdonne quand on l'approche de l'escalier."

#: assets/data/catalog.json
msgid "Dark, heavy, faintly warm. The Ember Seal was poured from this seam fifty years ago."
msgstr "Sombre, lourd, à peine tiède. Le Sceau de braise a été coulé avec le fer de ce filon, il y a cinquante ans."

#: assets/data/catalog.json
msgid "Death at a distance"
msgstr "La mort à distance"

#: assets/data/catalog.json
msgid "Deep Root"
msgstr "Racine profonde"

#: assets/data/catalog.json
msgid "Deeper than the mountain is tall. It glows in the dark of the shelf."
msgstr "Plus profond que la montagne n'est haute. Il luit dans l'ombre de l'étagère."

#: assets/data/catalog.json
msgid "Deeproot Bow"
msgstr "Arc de racine profonde"

#: assets/data/catalog.json
msgid "Dragon Scale"
msgstr "Écaille de dragon"

#: assets/data/catalog.json
msgid "Dragon Tonic"
msgstr "Tonique de dragon"

#: assets/data/catalog.json
msgid "Dragon scale from the knee down. Crafted, never sold."
msgstr "De l'écaille de dragon, du genou jusqu'en bas. Fait main, jamais en vente."

#: assets/data/catalog.json
msgid "Dragonbane"
msgstr "Fléau des dragons"

#: assets/data/catalog.json
msgid "Dragonscale over boiled hide. Crafted, never sold."
msgstr "Écailles de dragon sur cuir bouilli. Fait main, jamais en vente."

#: assets/data/catalog.json
msgid "Dried Meat"
msgstr "Viande séchée"

#: assets/data/catalog.json
msgid "Driftwood, bleached and banded with sea glass. Light enough to dance with. Crafted, never sold."
msgstr "Bois flotté, blanchi et cerclé de verre de mer. Assez léger pour danser avec. Fait main, jamais en vente."

#: assets/data/catalog.json
msgid "Drowned Signet"
msgstr "Chevalière noyée"

#: assets/data/catalog.json
msgid "Duelist's Ring"
msgstr "Anneau du duelliste"

#: assets/data/catalog.json
msgid "Dwarven runes still glow when danger is near. They glow a lot down here."
msgstr "Les runes naines luisent encore à l'approche du danger. Ici-bas, elles luisent souvent."

#: assets/data/catalog.json
msgid "Elixir"
msgstr "Élixir"

#: assets/data/catalog.json
msgid "Ember Salve"
msgstr "Baume de braise"

#: assets/data/catalog.json
msgid "Ember Shard"
msgstr "Éclat de braise"

#: assets/data/catalog.json
msgid "Emberwood Staff"
msgstr "Bâton de bois de braise"

#: assets/data/catalog.json
msgid "Enchanted Robe"
msgstr "Robe enchantée"

#: assets/data/catalog.json
msgid "Everflask"
msgstr "Flasque éternelle"

#: assets/data/catalog.json
msgid "Every family of monster knows your step."
msgstr "Chaque famille de monstres connaît votre pas."

#: assets/data/catalog.json
msgid "Every fisher catches one. Nobody knows whose they were."
msgstr "Chaque pêcheur en attrape une. Personne ne sait à qui elles étaient."

#: assets/data/catalog.json
msgid "Every page of the codex, filled."
msgstr "Chaque page du codex, remplie."

#: assets/data/catalog.json
msgid "Every step rings. Sneaking is for other people. Crafted, never sold."
msgstr "Chaque pas résonne. La discrétion, c'est pour les autres. Fait main, jamais en vente."

#: assets/data/catalog.json
msgid "Everything they touch keeps dying"
msgstr "Tout ce qu'il touche se meurt"

#: assets/data/catalog.json
msgid "Fast and sneaky. Quick on their feet, deadly with a backstab."
msgstr "Rapide et sournois. Vif sur ses appuis, mortel d'un coup dans le dos."

#: assets/data/catalog.json
msgid "Fast, sharp, gone"
msgstr "Vif, tranchant, envolé"

#: assets/data/catalog.json
msgid "Feeds a family. Also perforates goblins."
msgstr "Nourrit une famille. Perfore aussi les gobelins."

#: assets/data/catalog.json
msgid "Fenwick's Locket"
msgstr "Médaillon de Fenwick"

#: assets/data/catalog.json
msgid "Festival Pie"
msgstr "Tourte de fête"

#: assets/data/catalog.json
msgid "Fingerless, for the knots. Saltmere's net-menders swear by them. Crafted, never sold."
msgstr "Sans doigts, pour les nœuds. Les ramendeurs de Saltmere ne jurent que par eux. Fait main, jamais en vente."

#: assets/data/catalog.json
msgid "Fingerless, so the hands can still shape a spell. Crafted, never sold."
msgstr "Sans doigts, pour que les mains puissent encore façonner un sort. Fait main, jamais en vente."

#: assets/data/catalog.json
msgid "Fireball"
msgstr "Boule de feu"

#: assets/data/catalog.json
msgid "Flawless Emerald"
msgstr "Émeraude parfaite"

#: assets/data/catalog.json
msgid "For looking the part, every piece of it."
msgstr "Pour avoir l'allure qu'il faut, jusqu'à la dernière pièce."

#: assets/data/catalog.json
msgid "Forest Herb"
msgstr "Herbe des bois"

#: assets/data/catalog.json
msgid "Forged for exactly one purpose. You will know when."
msgstr "Forgé dans un seul but. Vous saurez quand."

#: assets/data/catalog.json
msgid "Forged from a skull that once breathed fire at its wearer."
msgstr "Forgée dans un crâne qui, jadis, crachait le feu sur celui qui la porte."

#: assets/data/catalog.json
msgid "Forged from the beams that burned on the Night of Ash. Nothing gets through it twice."
msgstr "Taillée dans les poutres qui ont brûlé pendant la Nuit des Cendres. Rien ne la traverse deux fois."

#: assets/data/catalog.json
msgid "Fountain Day Roast"
msgstr "Rôti du jour de la Fontaine"

#: assets/data/catalog.json
msgid "Fountain Guard"
msgstr "Bouclier de la Fontaine"

#: assets/data/catalog.json
msgid "Fountain Tonic"
msgstr "Tonique de la Fontaine"

#: assets/data/catalog.json
msgid "Fresh Fish"
msgstr "Poisson frais"

#: assets/data/catalog.json
msgid "From further down than anyone has a word for."
msgstr "D'un fond plus bas que tous les mots connus."

#: assets/data/catalog.json
msgid "Frontline bruiser. High health and defense, hits hard with steel."
msgstr "Cogneur de première ligne. Beaucoup de vie et de défense, frappe fort à l'acier."

#: assets/data/catalog.json
msgid "Frost Lily"
msgstr "Lys de givre"

#: assets/data/catalog.json
msgid "Frost Nova"
msgstr "Nova de givre"

#: assets/data/catalog.json
msgid "Frostweave"
msgstr "Tisse-givre"

#: assets/data/catalog.json
msgid "Frostweave Boots"
msgstr "Bottes tisse-givre"

#: assets/data/catalog.json
msgid "Frostweave Hood"
msgstr "Capuche tisse-givre"

#: assets/data/catalog.json
msgid "Frostweave Mitts"
msgstr "Mitaines tisse-givre"

#: assets/data/catalog.json
msgid "Frostweave Robe"
msgstr "Robe tisse-givre"

#: assets/data/catalog.json
msgid "Fur boots that never slip on ice. Mostly. Crafted, never sold."
msgstr "Des bottes fourrées qui ne glissent jamais sur la glace. Presque. Fait main, jamais en vente."

#: assets/data/catalog.json
msgid "Gale Longbow"
msgstr "Arc long des bourrasques"

#: assets/data/catalog.json
msgid "Glass cannon, loud spells"
msgstr "Canon de verre, sorts bruyants"

#: assets/data/catalog.json
msgid "Glass cannon. Fragile, but Fireball melts anything with a face."
msgstr "Canon de verre. Fragile, mais Boule de feu fait fondre tout ce qui a un visage."

#: assets/data/catalog.json
msgid "Gold Coins"
msgstr "Pièces d'or"

#: assets/data/catalog.json
msgid "Grave Chill"
msgstr "Froid du tombeau"

#: assets/data/catalog.json
msgid "Grave Moss"
msgstr "Mousse des tombes"

#: assets/data/catalog.json
msgid "Grave Ward"
msgstr "Garde sépulcrale"

#: assets/data/catalog.json
msgid "Greater Health Potion"
msgstr "Grande potion de soin"

#: assets/data/catalog.json
msgid "Green and frosted, washed smooth by the tide off Saltmere. Crafters prize it."
msgstr "Vert et dépoli, lissé par la marée au large de Saltmere. Les artisans en raffolent."

#: assets/data/catalog.json
msgid "Greyhold"
msgstr "Greyhold"

#: assets/data/catalog.json
msgid "Greyhold Badge"
msgstr "Insigne de Greyhold"

#: assets/data/catalog.json
msgid "Greyhold Warden"
msgstr "Gardien de Greyhold"

#: assets/data/catalog.json
msgid "Greyhold's old pattern: a steel cap, a slit to see by. Crafted, never sold."
msgstr "Le vieux modèle de Greyhold : une calotte d'acier, une fente pour y voir. Fait main, jamais en vente."

#: assets/data/catalog.json
msgid "Greymaw's Hood"
msgstr "Capuche de Gueule-Grise"

#: assets/data/catalog.json
msgid "Gulp's Gilded Tooth"
msgstr "Dent dorée de Glouglou"

#: assets/data/catalog.json
msgid "Gunnar's Strongbox"
msgstr "Coffre de Gunnar"

#: assets/data/catalog.json
msgid "Hammered from the seam's own iron, dark as a cellar. Crafted, never sold."
msgstr "Martelé dans le fer même du filon, sombre comme une cave. Fait main, jamais en vente."

#: assets/data/catalog.json
msgid "Healing light through gauntleted palms."
msgstr "Une lumière guérisseuse à travers des paumes gantées de fer."

#: assets/data/catalog.json
msgid "Health Potion"
msgstr "Potion de soin"

#: assets/data/catalog.json
msgid "Heartwood bent to a killing curve. Crafted, never sold."
msgstr "Du bois de cœur ployé en une courbe meurtrière. Fait main, jamais en vente."

#: assets/data/catalog.json
msgid "Heavy enough to anchor a boat. Warm, somehow, even in snow. Crafted, never sold."
msgstr "De quoi ancrer un bateau. Et, allez savoir pourquoi, on y a chaud même dans la neige. Fait main, jamais en vente."

#: assets/data/catalog.json
msgid "Heavy for its size, and colder than snow."

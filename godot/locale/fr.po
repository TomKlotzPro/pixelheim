msgstr "Le tableau des primes"

#: assets/data/hints.json
msgid "The notice board"
msgstr "Le tableau d'avis"

#: assets/data/hints.json
msgid "Turn sideways"
msgstr "Tournez l'écran"

#: assets/data/hints.json
msgid "Your house"
msgstr "Votre maison"

#: assets/data/hints.json
msgid "Your journal"
msgstr "Votre journal"

#: assets/data/hints.json

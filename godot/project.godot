; Pixelheim Godot spike (PIX-118).
config_version=5

[application]

config/name="Pixelheim"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
; Pinned so renaming the project never orphans player saves in user://.
config/use_custom_user_dir=true
config/custom_user_dir_name="pixelheim"

[autoload]

GameState="*res://scripts/state/game_state.gd"
Sound="*res://scripts/sound.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/custom_font="res://assets/fonts/CourierPrime-Bold.ttf"

[rendering]

textures/canvas_textures/default_texture_filter=0

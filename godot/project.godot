; Pixelheim (Godot 4.7), the game at tomklotzpro.github.io/pixelheim/.
config_version=5

[application]

config/name="Pixelheim"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
; Pinned so renaming the project never orphans player saves in user://.
config/use_custom_user_dir=true
config/custom_user_dir_name="pixelheim"
; The gold P on the title's night (tools/favicon.py): the web build's favicon,
; its home-screen icon and the desktop window's.
config/icon="res://assets/icon.png"
; While the game loads, nothing but the title's night sky (TitleScene.SKY's
; #080c28), no picture and no words (PIX-295: the old title's picture, with
; its English tagline, outlived the title); the web page's quiet bar is
; export_presets.cfg's html/head_include, and the title rises out of this.
boot_splash/bg_color=Color(0.03137255, 0.04705882, 0.15686275, 1)
boot_splash/show_image=false

[autoload]

GameState="*res://scripts/state/game_state.gd"
Sound="*res://scripts/sound.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/custom_font="res://assets/fonts/PixeloidSans.ttf"

[internationalization]

locale/translations=PackedStringArray("res://locale/fr.po")

[physics]

; Motion is drawn between physics ticks (actors only, see world.gd): no
; stutter on screens faster than the 60 Hz physics.
common/physics_interpolation=true

[shader_globals]

; What moves in the open air (PIX-223, shaders/wind.gdshaderinc): the world's
; clock and the wind's strength, set each frame by scripts/light_rig.gd.
world_time={
"type": "float",
"value": 0.0
}
world_wind={
"type": "float",
"value": 1.0
}
; Where the map the hero stands on lies in the plane of the Reach's maps, in
; pixels (One Reach, PIX-269, step 5): the wind and the ground's slow noise
; run on the plane, unbroken across a line; set by scripts/world.gd.
plane_origin={
"type": "vec2",
"value": Vector2(0, 0)
}
; 1 while the desktop app draws the canvas in linear light (PIX-227,
; shaders/linear.gdshaderinc), set by scripts/light_rig.gd; 0 in the browser.
world_linear={
"type": "float",
"value": 0.0
}

[rendering]

textures/canvas_textures/default_texture_filter=0
; The macOS app is universal (Intel and Apple silicon), and its export asks
; for both VRAM formats (PIX-227); no texture here is VRAM-compressed.
textures/vram_compression/import_etc2_astc=true

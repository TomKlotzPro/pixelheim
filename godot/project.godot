; Pixelheim (Godot 4.7), the game at tomklotzpro.github.io/pixelheim/.
config_version=5

[application]

config/name="Pixelheim"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
; Pinned so renaming the project never orphans player saves in user://.
config/use_custom_user_dir=true
config/custom_user_dir_name="pixelheim"
; The gold P on the title's night (tools/favicon.py): the web build's favicon,
; its home-screen icon and the desktop window's.
config/icon="res://assets/icon.png"
; While the game loads, the title's night (PIX-296): assets/splash.png, drawn
; in code by tools/splash.py (the sky, the mountain, the village asleep and
; the logo where the title draws it, no other words: PIX-295), fitted to the
; window unsmoothed (2x at 1280x720), in black bars on a window of another
; shape as the game's own canvas is. The web page shows the same picture with life in it
; (web/shell.html), and the title rises out of it on a launch.
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://assets/splash.png"
boot_splash/use_filter=false

[autoload]

GameState="*res://scripts/state/game_state.gd"
Sound="*res://scripts/sound.gd"

[debug]

; The checker says where a script reaches for something it can't see
; (PIX-499): a property or a method the type doesn't have, a value handed on
; as a narrower type, a `for` with no type. Warnings, counted in the editor
; and by its language server; they become errors only once none is left.
; Most of what's left reads the game's dictionaries (`int(hero["hp"])` is
; an unsafe argument to the checker) or a foe, whose script has no class yet.
gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_call_argument=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/custom_font="res://assets/fonts/Nunito-Regular.ttf"

[internationalization]

; ICU's line-break rules go in the export (PIX-471): without them an
; exported build breaks a line after any space, a no-break one too, and
; French parts « 70 » from « or » and a word from its « ! ».
locale/include_text_server_data=true
locale/translations=PackedStringArray("res://locale/en.po", "res://locale/fr.po")

[physics]

; Motion is drawn between physics ticks (actors only, see world.gd): no
; stutter on screens faster than the 60 Hz physics.
common/physics_interpolation=true

[shader_globals]

; What moves in the open air (PIX-223, shaders/wind.gdshaderinc): the world's
; clock and the wind's strength, set each frame by scripts/light_rig.gd.
world_time={
"type": "float",
"value": 0.0
}
world_wind={
"type": "float",
"value": 1.0
}
; How strongly the lamps and the lantern shape the art (PIX-528,
; shaders/relief.gdshaderinc): 0 with Light relief off, Lights.RELIEF on;
; set each frame by scripts/light_rig.gd.
relief={
"type": "float",
"value": 0.0
}
; How strongly the lights rim what stands on its side facing them (PIX-531,
; shaders/relief.gdshaderinc's RELIEF_RIM): 0 by day, Lights.RIM in the
; dark; set each frame by scripts/light_rig.gd.
light_rim={
"type": "float",
"value": 0.0
}
; Where the map the hero stands on lies in the plane of the Reach's maps, in
; pixels (One Reach, PIX-269, step 5): the wind and the ground's slow noise
; run on the plane, unbroken across a line; set by scripts/world.gd.
plane_origin={
"type": "vec2",
"value": Vector2(0, 0)
}
; 1 while the desktop app draws the canvas in linear light (PIX-227,
; shaders/linear.gdshaderinc), set by scripts/light_rig.gd; 0 in the browser.
world_linear={
"type": "float",
"value": 0.0
}
; Where the hero and the nearest foe hunting them stand, in the canvas, so
; what stands over them turns see-through round them (PIX-429, PIX-430,
; shaders/see_through.gdshaderinc): set each frame by scripts/world.gd and
; scripts/world_foes.gd, far off when there is no one.
hero_at={
"type": "vec2",
"value": Vector2(-100000, -100000)
}
foe_at={
"type": "vec2",
"value": Vector2(-100000, -100000)
}
; The sun for the scenery's shadows (PIX-449, shaders/scenery_shadow.gdshader,
; DayNight.sun): where a shadow reaches for each pixel of height (x, y) and
; how strong it is (z), none at night, under cloud or out of the sky; and
; the moon (w, the night's dark under a clear sky: the roofs' rim and the
; chimneys' smoke, PIX-523); set each frame by scripts/light_rig.gd.
sun={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
; What the rain leaves (PIX-491, shaders/puddles.gdshader): how wet the
; ground is (x), how full its puddles (y), how hard it rains now (z) and
; how dark the hour is (w), 0..1; set each frame by scripts/storm.gd from
; Weather's clock and the LightRig's dark.
ground_wet={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}

[rendering]

textures/canvas_textures/default_texture_filter=0
; The macOS app is universal (Intel and Apple silicon), and its export asks
; for both VRAM formats (PIX-227); no texture here is VRAM-compressed.
textures/vram_compression/import_etc2_astc=true

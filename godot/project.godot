; Pixelheim (Godot 4.7), the game at tomklotzpro.github.io/pixelheim/.
config_version=5

[application]

config/name="Pixelheim"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
; Pinned so renaming the project never orphans player saves in user://.
config/use_custom_user_dir=true
config/custom_user_dir_name="pixelheim"
; The gold P on the title's night (tools/favicon.py): the web build's favicon,
; its home-screen icon and the desktop window's.
config/icon="res://assets/icon.png"
; While the game loads, the title's night (PIX-296): assets/splash.png, drawn
; in code by tools/splash.py (the sky, the mountain, the village asleep and
; the logo where the title draws it, no other words: PIX-295), fitted to the
; window unsmoothed (2x at 1280x720), in black bars on a window of another
; shape as the game's own canvas is. The web page shows the same picture with life in it
; (web/shell.html), and the title rises out of it on a launch.
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://assets/splash.png"
boot_splash/use_filter=false

[autoload]

GameState="*res://scripts/state/game_state.gd"
Sound="*res://scripts/sound.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/custom_font="res://assets/fonts/PixeloidSans.ttf"

[internationalization]

locale/translations=PackedStringArray("res://locale/fr.po")

[physics]

; Motion is drawn between physics ticks (actors only, see world.gd): no
; stutter on screens faster than the 60 Hz physics.
common/physics_interpolation=true

[shader_globals]

; What moves in the open air (PIX-223, shaders/wind.gdshaderinc): the world's
; clock and the wind's strength, set each frame by scripts/light_rig.gd.
world_time={
"type": "float",
"value": 0.0
}
world_wind={
"type": "float",
"value": 1.0
}
; Where the map the hero stands on lies in the plane of the Reach's maps, in
; pixels (One Reach, PIX-269, step 5): the wind and the ground's slow noise
; run on the plane, unbroken across a line; set by scripts/world.gd.
plane_origin={
"type": "vec2",
"value": Vector2(0, 0)
}
; 1 while the desktop app draws the canvas in linear light (PIX-227,
; shaders/linear.gdshaderinc), set by scripts/light_rig.gd; 0 in the browser.
world_linear={
"type": "float",
"value": 0.0
}
; Where the hero and the nearest foe hunting them stand, in the canvas, so
; what stands over them turns see-through round them (PIX-429, PIX-430,
; shaders/see_through.gdshaderinc): set each frame by scripts/world.gd and
; scripts/world_foes.gd, far off when there is no one.
hero_at={
"type": "vec2",
"value": Vector2(-100000, -100000)
}
foe_at={
"type": "vec2",
"value": Vector2(-100000, -100000)
}
; The sun for the scenery's shadows (PIX-449, shaders/scenery_shadow.gdshader,
; DayNight.sun): where a shadow reaches for each pixel of height (x, y) and
; how strong it is (z), none at night, under cloud or out of the sky; set
; each frame by scripts/light_rig.gd.
sun={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}

[rendering]

textures/canvas_textures/default_texture_filter=0
; The macOS app is universal (Intel and Apple silicon), and its export asks
; for both VRAM formats (PIX-227); no texture here is VRAM-compressed.
textures/vram_compression/import_etc2_astc=true

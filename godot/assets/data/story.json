          500
        ]
      },
      {
        "kind": "caption",
        "text": "Beside it an old man sits up, as if he'd heard you coming.",
        "hold": 3.4
      },
      {
        "kind": "caption",
        "text": "\"You're late, courier. Fifty years late.\"",
        "hold": 3.4
      },
      {
        "kind": "caption",
        "text": "You wake to the smell of smoke and Sela snoring.",
        "hold": 3.0
      },

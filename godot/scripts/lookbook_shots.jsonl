# The look book's shots (Lookbook, PIX-220), one a line (PIX-356): a JSON
# object whose `shot` is its name (its picture's file and `--only`'s word),
# then its `area` and how it's staged (lookbook.gd says what each key does);
# `cell` is [x, y], `time` day, dusk or night, and `drops` maps "x,y" cells to
# items. A line starting with # is a note on the shots below it. A new shot
# goes with its area's. Two branches adding shots keep both on a merge
# (merge=union in .gitattributes); test_registries refuses a shot named twice.
{"shot": "town_day", "area": "town", "map": "town", "at": "street", "time": "day"}
{"shot": "town_dusk", "area": "town", "map": "town", "at": "street", "time": "dusk"}
{"shot": "town_night", "area": "town", "map": "town", "at": "street", "time": "night"}
{"shot": "riverside", "area": "town", "map": "town", "cell": [72, 8], "time": "day"}
# The village's river where it turns west under the rampart (PIX-306):
# deep down its middle, flowing, foam at its banks; by day and at night.
{"shot": "town_river", "area": "town", "map": "town", "cell": [60, 33], "time": "day"}
{"shot": "town_river_night", "area": "town", "map": "town", "cell": [60, 33], "time": "night"}
# The village's gate from inside (PIX-248): one rampart, the gatehouse
# three wide between its towers, the road running on out through the
# fields; and its torches at night.
{"shot": "town_gate", "area": "town", "map": "town", "cell": [40, 5], "time": "day"}
{"shot": "town_gate_night", "area": "town", "map": "town", "cell": [40, 5], "time": "night"}
# The hero's walk (PIX-243), filmed (`film`) setting off, striding, turning
# right round and settling, then walking up the street.
{"shot": "walk", "area": "town", "map": "town", "cell": [38, 13], "time": "day", "walk": true}
# Turning in the walk (PIX-293), filmed: down, then right with both keys
# held a moment on the way (the diagonal), up then left the same way,
# and down then right with no overlap; then a diagonal held and one key
# let go.
{"shot": "turn", "area": "town", "map": "town", "cell": [38, 13], "time": "day", "walk": true, "legs": "turn"}
